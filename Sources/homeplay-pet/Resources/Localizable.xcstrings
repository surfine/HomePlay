    },
    "clio.worldview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk never speaks for you: anything sent in your name is read back first and happens only after you say “OK”. Answers are temporary until you say “Keep”. You bring your own model, and it runs on this Mac when it can."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk 不替你发声：用你名义送出的，先念给你听、你说「好」才做。回答是暂时的，说「留下」才存。模型用你自己的，能在这台 Mac 上就在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk 不替你發聲：用你名義送出的，先唸給你聽、你說「好」才做。回答是暫時的，說「留下」才存。模型用你自己的，能在這台 Mac 上就在這台 Mac 上。"
          }
        }
      }
    },
