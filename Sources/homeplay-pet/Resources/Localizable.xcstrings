{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "a11y.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force Click the screen to enter CarPlay. Right-click for the menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重按屏幕进入 CarPlay，右键打开菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重按螢幕進入 CarPlay，右鍵開啟選單"
          }
        }
      }
    },
    "a11y.hourDown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decrease Hour"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少小时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "減少小時"
          }
        }
      }
    },
    "a11y.hourUp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase Hour"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加小时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加小時"
          }
        }
      }
    },
    "a11y.pet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay desk pet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay 桌宠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay 桌寵"
          }
        }
      }
    },
    "anatomy.ambientLight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambient light sensor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境光传感器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境光感測器"
          }
        }
      }
    },
    "anatomy.ambientLight.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts screen brightness to the room"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按环境光自动调整屏幕亮度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依環境光自動調整螢幕亮度"
          }
        }
      }
    },
    "anatomy.baseModule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base speaker module"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底座扬声器模组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底座揚聲器模組"
          }
        }
      }
    },
    "anatomy.baseModule.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aluminum dome and mesh around the speaker enclosure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铝圆顶与网罩包住扬声器腔体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋁圓頂與網罩包住揚聲器腔體"
          }
        }
      }
    },
    "anatomy.camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center Stage camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Center Stage 相机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Center Stage 相機"
          }
        }
      }
    },
    "anatomy.camera.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12MP with Center Stage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1200 万像素，人物居中（Center Stage）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1200 萬像素，人物置中（Center Stage）"
          }
        }
      }
    },
    "anatomy.climate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature and humidity sensor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温湿度传感器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫濕度感測器"
          }
        }
      }
    },
    "anatomy.climate.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Senses room temperature and humidity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感测室内温度与湿度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感測室內溫度與濕度"
          }
        }
      }
    },
    "anatomy.coverGlass": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover glass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盖板玻璃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋板玻璃"
          }
        }
      }
    },
    "anatomy.coverGlass.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covers the whole display, with a camera opening at the top"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖整块显示屏，上缘留相机开孔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆蓋整塊顯示器，上緣留相機開孔"
          }
        }
      }
    },
    "anatomy.display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display panel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示面板"
          }
        }
      }
    },
    "anatomy.display.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7-inch IPS display, 1088×1088 pixels"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 英寸 IPS 显示屏，1088×1088 像素"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "7 吋 IPS 顯示器，1088×1088 像素"
          }
        }
      }
    },
    "anatomy.foot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底脚"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底腳"
          }
        }
      }
    },
    "anatomy.foot.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ring under the base that keeps it steady"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底座最下面一圈，稳住整机"
