    "podcasts.intro.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay opens the Podcasts library on this Mac read-only to show Up Next and your shows. Nothing is changed, uploaded or logged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌宠会只读地打开「播客」在这台 Mac 上的资料库，显示待播清单和节目。不修改、不上传、不记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌寵會唯讀打開「Podcast」在這台 Mac 上的資料庫，顯示待播清單和節目。不修改、不上傳、不記錄。"
          }
        }
      }
    },
