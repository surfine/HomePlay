    "clio.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you ask, and the data used to answer it (such as those few calendar events), goes straight from this Mac to the company you choose and is handled under its terms. This is not Apple’s Private Cloud Compute. Your key is stored only in this Mac’s keychain, and HomePlay never sends it to anyone. “Apple Intelligence” never goes online, but it works only while Apple Intelligence is on, and answers are shorter. With “This Mac (LM Studio)” the conversation stays on this Mac and the model you loaded answers; search terms go to DeepSeek only when Web Search is on and you have a DeepSeek key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你问的话和回答时用到的资料（例如那几笔日历），会直接从这台 Mac 送到你选的公司，按它的条款处理；这和 Apple 的私有云计算不一样。密钥只存在这台 Mac 的钥匙串，HomePlay 不会传给任何人。选「Apple Intelligence」就完全不联网，但只有它打开时能用，回答也比较简短。选「这台 Mac（LM Studio）」时对话留在这台 Mac，用你载入的模型回答；只有开着「网页搜索」又有 DeepSeek 密钥时，搜索词才会送给 DeepSeek。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你問的話和回答時用到的資料（例如那幾筆行事曆），會直接從這台 Mac 送到你選的公司，照它的條款處理；這和 Apple 的私有雲端運算不一樣。金鑰只存在這台 Mac 的鑰匙圈，HomePlay 不會傳給任何人。選「Apple Intelligence」就完全不連網，但只有它開著時能用，回答也比較簡短。選「這台 Mac（LM Studio）」時對話留在這台 Mac，用你載入的模型回答；只有開著「網頁搜尋」又有 DeepSeek 金鑰時，搜尋詞才會送給 DeepSeek。"
          }
        }
      }
    },
    "clio.provider": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model provider"
