    "promo.web.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yogurt keeps this loaf moist without being heavy, and lemon zest and blueberries make every bite bright. It all comes together in one bowl."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优格让这条磅蛋糕湿润又不腻，柠檬皮和蓝莓让每一口都很清爽。一个碗就能做完。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優格讓這條磅蛋糕濕潤又不膩，檸檬皮和藍莓讓每一口都很清爽。一個碗就能做完。"
          }
        }
      }
    },
