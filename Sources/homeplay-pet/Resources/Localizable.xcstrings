    "remote.step.battery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old batteries kept on the charger for years can swell. On newer models, set an 80% limit in Battery Health; on older ones, use a smart plug that cuts power on a schedule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常年插电的旧电池会膨胀：新机型在「电池健康」设 80% 上限；旧机型接一个能排程断电的智能插座。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常年插電的舊電池會膨脹：新機型在「電池健康度」設 80% 上限；舊機型接一個能排程斷電的智慧插座。"
          }
        }
      }
    },
    "remote.step.guided.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Accessibility › Guided Access. Triple-click the side button to lock the device to HomePlay, so little hands can’t leave it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 › 辅助功能 › 引导式访问，连按三下侧边按钮把它锁在 HomePlay 里，小孩乱点也跳不出去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › 輔助使用 › 引導使用模式，連按三下側邊按鈕鎖在 HomePlay 裡，小孩亂點也跳不出去。"
          }
        }
      }
    },
    "remote.step.guided.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guided Access (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引导式访问（可选）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引導使用模式（可選）"
          }
        }
      }
    },
    "remote.step.home.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share › Add to Home Screen. Open it from that icon and it runs full screen, without the address bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享 › 添加到主屏幕，之后从那个图标打开就是全屏，没有地址栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享 › 加入主畫面，之後從那個圖示打開就是全螢幕，沒有網址列。"
          }
        }
      }
    },
    "remote.step.home.title": {
      "localizations": {
        "en": {
