    "anatomy.microphones.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four mics: front, left, right and back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四个麦克风：前、左、右、后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四顆麥克風：前、左、右、後"
          }
        }
      }
    },
    "anatomy.power": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB-C power"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
