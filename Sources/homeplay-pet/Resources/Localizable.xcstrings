    "mic.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风权限未开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風權限未開啟"
          }
        }
      }
    },
    "mic.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay video still works. ClioTalk, Siri on iPhone and phone calls need the microphone. Allow HomePlay in System Settings › Privacy & Security › Microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 画面不受影响；ClioTalk、iPhone 的 Siri 和电话通话需要麦克风。请在系统设置 › 隐私与安全性 › 麦克风里允许 HomePlay。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 畫面不受影響；ClioTalk、iPhone 的 Siri 和電話通話需要麥克風。請在系統設定 › 隱私權與安全性 › 麥克風裡允許 HomePlay。"
          }
        }
      }
    },
    "mic.openSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
