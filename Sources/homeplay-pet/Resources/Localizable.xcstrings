    "mic.allowed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk, CarPlay calls and Siri on iPhone can use the microphone. Video and local playback are unaffected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk、CarPlay 通话和 iPhone 的 Siri 可以使用麦克风；屏幕画面与本地播放不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk、CarPlay 通話和 iPhone 的 Siri 可以使用麥克風；螢幕畫面與本機播放不受影響。"
          }
        }
      }
    },
    "gaze.pitch.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Me: Pitch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随我：俯仰角度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨我：俯仰角度"
          }
        }
      }
    },
    "gaze.pitch.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the slider to set the maximum head pitch. 0° turns the head without nodding. The setting is remembered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑块调整抬头/低头的最大角度；0° 只转头不点头。设置会记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動滑桿調整抬頭/低下的最大角度；0° 只轉頭不點頭。設定會記住。"
          }
        }
      }
    },
