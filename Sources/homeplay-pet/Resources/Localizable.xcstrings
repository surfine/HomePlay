        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插上資料線，解鎖 iPhone 並點「信任」"
          }
        }
      }
    },
    "status.overlay.cableHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cable? It will switch to Bluetooth pairing shortly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有线也没关系：稍后会自动改为蓝牙配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有線也沒關係：稍後會自動改為藍牙配對"
          }
        }
      }
    },
    "status.overlay.cableChip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One cable is all the first setup needs"
