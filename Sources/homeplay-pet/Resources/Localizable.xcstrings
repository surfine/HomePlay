    "perm.camera.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To turn toward you.\nNothing is recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转头看你、配合房间光线\n不录制、不上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉頭看你、配合房間光線\n不錄製、不上傳"
          }
        }
      }
    },
    "perm.mic.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold F5 to talk.\nNothing is recorded; audio stays on this Mac or your iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 F5 说话\n声音不录下，只交给这台 Mac 或你的 iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 F5 說話\n聲音不錄下，只交給這台 Mac 或你的 iPhone"
          }
        }
      }
    },
    "perm.input.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "F5 opens ClioTalk from any app.\nOnly that key is watched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何 App 里按 F5 叫 ClioTalk\n只认这一个键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何 App 裡按 F5 叫 ClioTalk\n只認這一個鍵"
          }
        }
      }
    },
    "perm.automation.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what’s playing.\nClick to play or pause."
