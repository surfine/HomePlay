    "clio.lm.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk connects to LM Studio on this Mac and answers with the model you have loaded. No key needed. If LM Studio isn’t running it tries to start it, and if no model is loaded it picks one. A model needs tool support to control the home; otherwise it can only chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk 连到这台 Mac 上的 LM Studio，用你载入的模型回答，不需要密钥。LM Studio 没开会试着叫它起来；没有载入模型时会挑一个载入。模型要支持工具才能控制家里，否则只能聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ClioTalk 連到這台 Mac 上的 LM Studio，用你載入的模型回答，不需要金鑰。LM Studio 沒開會試著叫它起來；沒有載入模型時會挑一個載入。模型要支援工具才能控制家裡，否則只能聊天。"
          }
        }
      }
    },
