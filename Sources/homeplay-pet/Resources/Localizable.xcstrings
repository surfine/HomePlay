            "state": "translated",
            "value": "用資料線連一次 iPhone"
          }
        }
      }
    },
    "status.overlay.cableBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug in a cable, unlock the iPhone, and tap Trust"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插上数据线，解锁 iPhone 并点「信任」"
          }
