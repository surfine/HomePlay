        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your iPhone once with a cable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用数据线连一次 iPhone"
          }
        },
        "zh-Hant": {
