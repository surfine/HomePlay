    "forget.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay will stop using it and remove its Bluetooth pairing on this Mac. You'll then see the one step left on iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay 会停止使用它，并删除这台 Mac 上的蓝牙配对。之后会告诉你 iPhone 上还要做哪一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay 會停止使用它，並刪除這台 Mac 上的藍牙配對。之後會告訴你 iPhone 上還要做哪一步。"
          }
        }
      }
    },
