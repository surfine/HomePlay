            "value": "南瓜去皮切塊，洋蔥切絲。"
          }
        }
      }
    },
    "recipe.demo.s2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Melt the butter in a pot over medium heat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锅里放奶油，中火融化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍋裡放奶油，中火融化。"
          }
        }
      }
    },
    "recipe.demo.s3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the pumpkin and onion to the pot and sauté over medium heat until the onion turns translucent, about 8 minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "南瓜和洋葱放进锅里，中火炒到洋葱变透明，大约 8 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "南瓜和洋蔥放進鍋裡，中火炒到洋蔥變透明，大約 8 分鐘。"
          }
        }
      }
    },
    "recipe.demo.s4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour in stock to just cover, bring to a boil, then lower the heat, cover and simmer for 25 minutes until the pumpkin is soft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入高汤盖过食材，煮开后转小火，盖上锅盖煮 25 分钟，直到南瓜软烂。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入高湯蓋過食材，煮開後轉小火，蓋上鍋蓋煮 25 分鐘，直到南瓜軟爛。"
          }
        }
      }
    },
    "recipe.demo.s5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the heat and let it cool for 5 minutes, blend until smooth, then season with salt and black pepper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关火放凉 5 分钟，用调理棒打成滑顺的浓汤，加盐和黑胡椒调味。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關火放涼 5 分鐘，用調理棒打成滑順的濃湯，加鹽和黑胡椒調味。"
          }
        }
      }
    },
    "recipe.demo.s6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladle into bowls, drizzle with a little cream and scatter pumpkin seeds on top."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盛盘，淋上一点鲜奶油，撒上南瓜籽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "盛盤，淋上一點鮮奶油，撒上南瓜籽。"
          }
        }
      }
    },
    "recipe.demo.title": {
      "localizations": {
