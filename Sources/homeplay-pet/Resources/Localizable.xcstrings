    "remote.enable.sub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only devices on the same Wi‑Fi can see this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个 Wi‑Fi 里的设备才看得到这台 Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個 Wi‑Fi 裡的裝置才看得到這台 Mac"
          }
        }
      }
    },
    "remote.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming devices need this Mac to stay awake. The picture stays on your home network and is encrypted; unpaired devices see nothing. Guest devices never see personal content such as Messages, Photos or Calendar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流的设备要这台 Mac 醒着。画面只在家里的网络里传，而且加密；没配对的设备什么都看不到。访客设备看不到信息、照片、日历这些个人内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流的裝置要這台 Mac 醒著。畫面只在家裡的網路裡傳，而且加密；沒配對的裝置什麼都看不到。訪客裝置看不到訊息、照片、行事曆這些個人內容。"
          }
        }
      }
    },
    "remote.listenFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices can't connect right now: another app is using the port. Turn this off and on again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在连不进来：连接端口被别的程序占着。关掉再打开试试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在連不進來：連接埠被別的程式占著。關掉再打開試試"
          }
        }
      }
    },
