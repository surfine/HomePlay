    "anatomy.power.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB-C port, 30W power adapter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB-C 接口，30W 电源适配器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "USB-C 接口，30W 電源轉接器"
          }
        }
      }
    },
    "anatomy.radiators": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passive radiators"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被动辐射器"
