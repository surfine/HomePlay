        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 iPhone 傳網頁"
          }
        }
      }
    },
    "handoff.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't Apple's Handoff — on a Mac, Handoff only goes to the default browser. The page opens on the pet; recipes go straight to Start Cooking."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 Apple 的「接力」：Mac 上接力只交给默认浏览器。网页在桌宠上打开，是食谱就直接进「开始烹饪」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 Apple 的「接力」：Mac 上接力只交給預設瀏覽器。網頁在桌寵上打開，是食譜就直接進「開始烹飪」。"
          }
        }
      }
    },
