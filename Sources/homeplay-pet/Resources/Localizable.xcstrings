    "gaze.pitch.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the slider to set the maximum head pitch. 0° turns the head without nodding. The setting is remembered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑块调整抬头/低头的最大角度；0° 只转头不点头。设置会记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動滑桿調整抬頭/低下的最大角度；0° 只轉頭不點頭。設定會記住。"
          }
        }
      }
