    "forget.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay will stop using it and try to remove the system Bluetooth pairing. If macOS keeps it, forget this Mac in the iPhone’s Bluetooth settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay 会停止使用它，并尝试删除系统蓝牙配对。若系统仍保留，可在 iPhone 的蓝牙设置里忘记这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay 會停止使用它，並嘗試刪除系統藍牙配對。若系統仍保留，可在 iPhone 的藍牙設定裡忘記這台 Mac。"
          }
        }
      }
    },
    "forget.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忘記"
          }
        }
      }
    },
    "forget.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget this iPhone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记这台 iPhone？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忘記這台 iPhone？"
          }
        }
      }
    },
    "gaze.denied.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow HomePlay in System Settings › Privacy & Security › Camera for Follow Me or Room Light. Frames are processed on this Mac and never saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 › 隐私与安全性 › 摄像头里允许 HomePlay，跟随我或房间光线才能使用摄像头。画面只在本机处理，不保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 › 隱私權與安全性 › 相機裡允許 HomePlay，跟隨我或房間光線才能使用相機。畫面只在本機處理，不儲存。"
          }
        }
      }
    },
    "gaze.denied.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
