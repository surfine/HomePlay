          "stringUnit": {
            "state": "translated",
            "value": "First allow HomePlay to read your Photos library"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先允许 HomePlay 读取「照片」图库"
          }
        },
        "zh-Hant": {
