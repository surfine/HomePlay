    "clio.data.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only when an answer needs it, and only those few items. Events, reminders and messages are read back to you and done only after you say OK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有回答需要时才读取，只送那几笔；加行程、加提醒、发信息之前会先念给你听，你说「好」才做"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有回答需要時才讀取，只送那幾筆；加行程、加提醒、傳訊息之前會先念給你聽，你說「好」才做"
          }
        }
      }
    },
