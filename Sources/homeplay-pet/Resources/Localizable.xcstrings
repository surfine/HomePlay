    "wifi.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the Wi-Fi the iPhone is on (not necessarily the one the Mac uses). If the Mac is on Ethernet or the two use different SSIDs, enter the iPhone’s network name and password. Leave the password empty when the iPhone is already on that network. macOS 26 no longer lets apps read keychain passwords; view it in System Settings and type it once (stored only on this Mac)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里填 iPhone 所连的 Wi-Fi（不一定是 Mac 自己连的那个）。Mac 用网线、或两者连不同 SSID 时，请填 iPhone 那个网络的名称和密码。iPhone 已在该网络上时密码可留空。macOS 26 不再允许 App 读取钥匙串密码，需要时请在系统设置里查看后手填（仅存在本机）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡填 iPhone 所連的 Wi-Fi（不一定是 Mac 自己連的那個）。Mac 用網路線、或兩者連不同 SSID 時，請填 iPhone 那個網路的名稱和密碼。iPhone 已在該網路上時密碼可留空。macOS 26 不再允許 App 讀取鑰匙圈密碼，需要時請在系統設定裡查看後手填（僅存在本機）。"
          }
        }
      }
    },
    "wifi.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
