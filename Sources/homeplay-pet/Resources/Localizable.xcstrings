    "intercom.honest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePod Intercom isn't open to other apps: your voice plays on this Mac (or the AirPlay speaker it's using) and isn't saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePod 的对讲没有开放给其他 App：你的声音会在这台 Mac（或它正在用的 AirPlay 扬声器）播出，不会存档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePod 的對講沒有開放給其他 App：你的聲音會在這台 Mac（或它正在用的 AirPlay 揚聲器）播出，不會存檔。"
