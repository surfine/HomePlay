    "clio.demo.cyanotype": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cyanotype process was invented in **1842** by English astronomer and chemist **Sir John Herschel**. He used it to copy his notes and diagrams: paper coated with light-sensitive iron salts turns a deep Prussian blue in sunlight and leaves a white print."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝晒法由英国天文学家兼化学家**约翰·赫歇尔爵士**在 **1842** 年发明。他用这种方法复制自己的笔记与图表：涂上感光铁盐的纸被阳光照到的地方会变成深深的普鲁士蓝，被遮住的地方留下白色的影像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍曬法由英國天文學家兼化學家**約翰·赫歇爾爵士**在 **1842** 年發明。他用這種方法複製自己的筆記與圖表：塗上感光鐵鹽的紙被陽光照到的地方會變成深深的普魯士藍，被遮住的地方留下白色的影像。"
          }
        }
      }
    },
    "clio.demo.question": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whose birthday is this week?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这周有谁生日？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這週有誰生日？"
          }
        }
      }
    },
