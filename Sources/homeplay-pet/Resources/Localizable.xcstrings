    "mic.allowed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay calls and Siri can use the microphone. Video and local playback are unaffected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 通话和 Siri 可以使用麦克风；屏幕画面与本地播放不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CarPlay 通話和 Siri 可以使用麥克風；螢幕畫面與本機播放不受影響。"
          }
        }
      }
    },
