    "remote.device.personal.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, Photos, Calendar, Reminders and FaceTime. Turn on only for your own devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息、照片、日历、提醒、FaceTime；只给你自己的设备打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息、照片、行事曆、提醒事項、FaceTime；只給你自己的裝置打開"
          }
        }
      }
    },
    "remote.device.personal.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The web version uses plain http: someone on the same Wi‑Fi could impersonate this device and see your personal content. Only turn this on at home on a network you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页版走的是一般 http：同一个 Wi‑Fi 里有心人可能冒充这台设备，看到你的个人内容。只在你信任的家庭网络里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網頁版走的是一般 http：同一個 Wi‑Fi 裡有心人可能冒充這台裝置，看到你的個人內容。只在你信任的家庭網路裡打開。"
          }
        }
      }
    },
    "remote.autoRevoke.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iPhone or iPad was removed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除一台 iPhone／iPad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除一台 iPhone／iPad"
          }
        }
      }
    },
    "remote.autoRevoke.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” connected from two network addresses at once, so someone may have copied its key. Pair it again to keep using it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」同时从两个网络地址连进来，可能有人复制了它的密钥。要继续用请重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」同時從兩個網路位址連進來，可能有人複製了它的金鑰。要繼續用請重新配對。"
          }
        }
      }
    },
    "remote.device.remove": {
      "localizations": {
