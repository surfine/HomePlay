    "safari.demo.p1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Autumn is soup weather: sweet squash and a little butter, on the table in 35 minutes and just right for four."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秋天最适合来一碗浓汤：南瓜的甜味加上一点奶油，三十五分钟就能上桌，四个人刚好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秋天最適合來一碗濃湯：南瓜的甜味加上一點奶油，三十五分鐘就能上桌，四個人剛好。"
          }
        }
      }
    },
    "safari.demo.p2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend it right in the pot with an immersion blender and skip washing the blender. Like it spicy? Finish with a pinch of chili."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用调理棒直接在锅里打，少洗一个果汁机。喜欢辣的话，最后撒一点辣椒粉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手持攪拌棒直接在鍋裡打，少洗一台果汁機。喜歡辣的話，最後撒一點辣椒粉。"
          }
        }
      }
    },
