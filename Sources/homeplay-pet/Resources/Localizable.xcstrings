    "handoff.steps.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a shortcut on iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上做一个快捷指令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上做一個捷徑"
          }
        }
      }
    },
    "handoff.steps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. New shortcut: turn on “Show in Share Sheet”, receive URLs.\n2. Add “Get Contents of URL”: the address above, Method POST, Header Authorization = “Bearer <pairing code>”, Request Body JSON: url = Shortcut Input.\n3. In Safari, tap Share → this shortcut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 新建快捷指令，打开「在共享表单中显示」，接收「URL」。\n2. 加「获取 URL 内容」：上面的网址，方法 POST，标头 Authorization 填「Bearer 配对码」，请求体 JSON：url ＝ 快捷指令输入。\n3. 在 Safari 里点分享 → 这个快捷指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 新增捷徑，打開「在分享表單中顯示」，接收「URL」。\n2. 加「取得 URL 內容」：上面的網址，方法 POST，標頭 Authorization 填「Bearer 配對碼」，要求本文 JSON：url ＝ 捷徑輸入。\n3. 在 Safari 裡點分享 → 這個捷徑。"
          }
        }
      }
    },
    "handoff.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Pages from iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
