          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 › 显示与亮度 › 自动锁定 › 永不。HomePlay 没人时自己会调暗，不怕整晚亮着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › 螢幕顯示與亮度 › 自動鎖定 › 永不。HomePlay 沒人時自己會調暗，不怕整晚亮著。"
