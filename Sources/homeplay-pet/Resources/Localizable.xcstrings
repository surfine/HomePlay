    "promo.recipe.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemon-Blueberry Yogurt Loaf Cake"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柠檬蓝莓优格磅蛋糕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檸檬藍莓優格磅蛋糕"
          }
        }
      }
    },
    "promo.recipe.i1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "¾ cup refined coconut oil, melted and cooled slightly, plus more for greasing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "¾ 杯精制椰子油，融化后稍微放凉，另备一些抹模具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "¾ 杯精製椰子油，融化後稍微放涼，另備一些抹模具"
          }
        }
      }
    },
    "promo.recipe.i2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 cups all-purpose flour"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 杯中筋面粉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2 杯中筋麵粉"
          }
        }
      }
    },
    "promo.recipe.i3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ¼ teaspoons baking powder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ¼ 茶匙泡打粉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ¼ 茶匙泡打粉"
          }
        }
      }
    },
    "promo.recipe.i4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "½ teaspoon baking soda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "½ 茶匙小苏打"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "½ 茶匙小蘇打"
          }
        }
      }
    },
    "promo.recipe.i5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "½ teaspoon kosher salt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "½ 茶匙犹太盐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "½ 茶匙猶太鹽"
          }
        }
      }
    },
    "promo.recipe.i6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 cup granulated sugar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 杯细砂糖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 杯細砂糖"
          }
        }
      }
    },
    "promo.recipe.i7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 large eggs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 颗大鸡蛋"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3 顆大雞蛋"
          }
        }
      }
    },
    "promo.recipe.i8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ cups whole-milk Greek yogurt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ 杯全脂希腊优格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ 杯全脂希臘優格"
          }
        }
      }
    },
    "promo.recipe.i9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 tablespoons finely grated lemon zest"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 大匙磨细的柠檬皮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2 大匙磨細的檸檬皮"
          }
        }
      }
    },
    "promo.recipe.i10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ teaspoons pure vanilla extract"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ 茶匙香草精"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ 茶匙香草精"
          }
        }
      }
    },
    "promo.recipe.i11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ cups fresh blueberries"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ 杯新鲜蓝莓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ½ 杯新鮮藍莓"
          }
        }
      }
    },
    "promo.recipe.s1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat the oven to 350°F. Grease a 9-by-5-inch loaf pan with coconut oil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烤箱预热到 180°C，长条模抹一层椰子油。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "烤箱預熱到 180°C，長條模抹一層椰子油。"
          }
        }
      }
    },
    "promo.recipe.s2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisk the sugar, eggs and yogurt for 1 minute, until smooth and pale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "糖、鸡蛋和优格一起搅打 1 分钟，到滑顺、颜色变浅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "糖、雞蛋和優格一起攪打 1 分鐘，到滑順、顏色變淺。"
          }
        }
      }
    },
    "promo.recipe.s3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stir in the flour, baking powder, baking soda and salt, then fold in the coconut oil, lemon zest, vanilla and blueberries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拌入面粉、泡打粉、小苏打和盐，再加椰子油、柠檬皮、香草精和蓝莓，拌匀就好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拌入麵粉、泡打粉、小蘇打和鹽，再加椰子油、檸檬皮、香草精和藍莓，拌勻就好。"
          }
        }
      }
    },
    "promo.recipe.s4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour into the pan and bake for 55 minutes, until a tester comes out clean. Cool for 20 minutes before slicing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒进模具，烤 55 分钟，到竹签插进去拿出来是干净的。放凉 20 分钟再切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒進模具，烤 55 分鐘，到竹籤插進去拿出來是乾淨的。放涼 20 分鐘再切。"
          }
        }
      }
    },
