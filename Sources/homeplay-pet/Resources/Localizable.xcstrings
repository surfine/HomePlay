    "demo.official.answer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here are the upcoming birthday celebrations on your calendar:\nWednesday, April 1: Maiko’s birthday · all-day\nFriday, April 17: Birthday celebration for Nick, Juan, and Vicki · Apr 17, 3:00–4:00 PM\nTuesday, April 28: Hunter’s birthday · all-day"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你行事历上接下来的生日：\n4月1日 周三：Maiko 的生日 · 全天\n4月17日 周五：Nick、Juan 和 Vicki 的生日派对 · 15:00–16:00\n4月28日 周二：Hunter 的生日 · 全天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你行事曆上接下來的生日：\n4月1日 週三：Maiko 的生日 · 全天\n4月17日 週五：Nick、Juan 和 Vicki 的生日派對 · 15:00–16:00\n4月28日 週二：Hunter 的生日 · 全天"
          }
        }
      }
    },
