    "promo.web.crumb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipes / Desserts / Cakes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱 / 甜点 / 蛋糕"
