    "status.help.share.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone shares its Wi‑Fi with HomePlay — no password to type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 会把现在的 Wi-Fi 分享给 HomePlay，不用打密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 會把現在的 Wi‑Fi 分享給 HomePlay，不用打密碼"
          }
        }
      }
    },
    "status.help.share.hint": {
      "localizations": {
