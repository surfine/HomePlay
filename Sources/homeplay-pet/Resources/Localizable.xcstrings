    },
    "anatomy.frame": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Electronics frame"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子框架"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電子框架"
          }
        }
      }
    },
    "anatomy.frame.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carries the logic board, camera, mics and two full-range drivers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "承载主板、相机、麦克风与两个全音域单元"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "承載主機板、相機、麥克風與兩個全音域單體"
          }
        }
      }
    },
    "anatomy.fullRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-range drivers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全音域单元"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全音域單體"
          }
        }
      }
    },
    "anatomy.fullRange.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two full-range drivers inside the display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器内两个全音域扬声器单元"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示器內兩顆全音域揚聲器單體"
          }
        }
      }
    },
    "anatomy.hinge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stainless steel hinge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不锈钢铰链"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不鏽鋼鉸鏈"
          }
        }
      }
    },
    "anatomy.hinge.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joins the display to the aluminum dome base"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不锈钢，连接显示器与铝圆顶底座"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不鏽鋼，連線顯示器與鋁圓頂底座"
          }
        }
      }
    },
    "anatomy.logicBoard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A18 logic board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A18 主板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A18 主機板"
          }
        }
      }
    },
    "anatomy.logicBoard.spec": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A18 chip with Neural Engine; accelerometer on board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "A18 芯片，内建神经网络引擎；含加速度计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "A18 晶片，內建神經網路引擎；含加速度計"
          }
        }
      }
    },
    "anatomy.microphones": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphones"
