    "wifi.rejectedRedacted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“<redacted>” is a macOS placeholder, not a real network name. Enter the actual SSID of the Wi-Fi the iPhone is on (shown in iPhone Settings › Wi-Fi)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「<redacted>」是 macOS 隐藏网络名后显示的占位文字，不是真实网络名。请填 iPhone 所连 Wi-Fi 的实际名称（可在 iPhone 的「设置 › Wi-Fi」里看到）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「<redacted>」是 macOS 隱藏網路名稱後顯示的佔位文字，不是真實網路名稱。請填 iPhone 所連 Wi-Fi 的實際名稱（可在 iPhone 的「設定 › Wi-Fi」裡看到）。"
          }
        }
      }
    },
    "wifi.save": {
