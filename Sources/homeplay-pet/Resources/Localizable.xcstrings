{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "a11y.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press firmly on the screen to connect CarPlay. Right-click for the menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重按屏幕连接 CarPlay，右键打开菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重按螢幕連接 CarPlay，右鍵打開選單"
          }
        }
      }
    },
    "a11y.pet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HomePlay desk pet"
          }
